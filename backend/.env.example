PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# OTP_DELIVERY options: console (local development only), msg91, twilio
OTP_DELIVERY=console

# MSG91 Flow API (configure an approved OTP template with a matching variable, e.g. var1)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VARIABLE=var1
# Optional override; default is MSG91 Flow API
# MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow/

# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a Twilio sender number
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_OTP_MESSAGE=Your EduTrack verification code is {otp}. It expires in 5 minutes.

SMS_REQUEST_TIMEOUT_MS=10000

# Firebase Admin service account (keep this private; never commit backend/.env)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"REPLACE_PROJECT_ID","private_key_id":"REPLACE_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-REPLACE@REPLACE_PROJECT_ID.iam.gserviceaccount.com","client_id":"REPLACE_CLIENT_ID","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_DATABASE_URL=https://REPLACE_PROJECT-default-rtdb.firebaseio.com
